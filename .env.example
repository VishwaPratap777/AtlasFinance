# Server config
PORT=3000
NODE_ENV=development
WEBHOOK_URL=https://your-app.onrender.com

# Optional: Telegram webhook path secret
WEBHOOK_SECRET=atlas_webhook_secret_change_me

# Password Authentication Layer
ACCESS_PASSWORD=Atlas@123
ADMIN_PASSWORD=123456789Vis@
